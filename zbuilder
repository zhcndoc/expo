FROM --platform=$BUILDPLATFORM node:24-bookworm AS builder

WORKDIR /app

ENV CI=true

RUN npm install -g pnpm

COPY . .

WORKDIR /app/docs

RUN pnpm install --frozen-lockfile

RUN NODE_OPTIONS=--max-old-space-size=6144 pnpm run export

FROM ikxin/caddy:latest

COPY --from=builder /app/docs/out /usr/share/caddy

EXPOSE 8080
